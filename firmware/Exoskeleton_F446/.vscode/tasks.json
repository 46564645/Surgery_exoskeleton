{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Firmware: Build Debug",
      "type": "process",
      "command": "/bin/sh",
      "args": [
        "${workspaceFolder}/build.sh",
        "Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Firmware: Build Release",
      "type": "process",
      "command": "/bin/sh",
      "args": [
        "${workspaceFolder}/build.sh",
        "Release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}
